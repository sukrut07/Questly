<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:padding="12dp">

    <!-- Header: Branding and Streak Badge -->
    <LinearLayout
        android:id="@+id/widget_compact_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QUESTLY"
            android:textColor="@color/questly_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_compact_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="🔥 3d"
            android:textColor="@color/questly_warning"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Progress: Level and XP -->
    <LinearLayout
        android:id="@+id/widget_compact_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_compact_header"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_compact_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LEVEL 05"
                android:textColor="@color/questly_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_compact_xp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="340 / 500 XP"
                android:textColor="@color/questly_secondary_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_compact_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:max="100"
            android:progress="68"
            android:progressDrawable="@drawable/widget_progress_bar_bg" />

        <TextView
            android:id="@+id/widget_compact_today_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today: 3/5 Quests • 45m Focus"
            android:textColor="@color/questly_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Action Button: Start Focus -->
    <TextView
        android:id="@+id/widget_compact_action_btn"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_accent_button"
        android:gravity="center"
        android:text="▶ Start Focus"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

</RelativeLayout>
