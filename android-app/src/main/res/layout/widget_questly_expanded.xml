<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:padding="14dp">

    <!-- Top Row: Branding and Streak Pill -->
    <LinearLayout
        android:id="@+id/widget_expanded_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QUESTLY • LIVING KINGDOM"
            android:textColor="@color/questly_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_expanded_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🔥 Streak: 4 days"
            android:textColor="@color/questly_warning"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- World Stage & Level Progression Banner -->
    <LinearLayout
        android:id="@+id/widget_expanded_world_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_expanded_top_bar"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_pill_background"
        android:padding="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_expanded_stage_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AWAKENING — LEVEL 05"
                android:textColor="@color/questly_primary_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/widget_expanded_xp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="340 / 500 XP"
                android:textColor="@color/questly_secondary_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_expanded_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="68"
            android:progressDrawable="@drawable/widget_progress_bar_bg" />
    </LinearLayout>

    <!-- Momentum Stats Row: Today's Focus & Daily Quests -->
    <LinearLayout
        android:id="@+id/widget_expanded_momentum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_expanded_world_banner"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_expanded_focus_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱ Today's Focus: 45 / 90 min"
            android:textColor="@color/questly_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_expanded_quests_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔ Daily Quests: 3 / 5 complete"
            android:textColor="@color/questly_success"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Recommended Quest Card -->
    <LinearLayout
        android:id="@+id/widget_expanded_quest_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_expanded_momentum"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_pill_background"
        android:padding="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT RECOMMENDED QUEST"
            android:textColor="@color/questly_gold"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_expanded_quest_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Complete System Architecture (45m)"
            android:textColor="@color/questly_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Quick Action Buttons: [Start Focus] [View Quests] -->
    <LinearLayout
        android:id="@+id/widget_expanded_actions"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_expanded_btn_focus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_accent_button"
            android:gravity="center"
            android:text="▶ Start Focus"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_expanded_btn_quests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="⚔ View Quests"
            android:textColor="@color/questly_secondary_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
