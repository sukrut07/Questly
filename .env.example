# ==============================================================================
# Questly 2.0 Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Backend Configuration (Web & Edge Functions)
# ------------------------------------------------------------------------------
# URL of your Supabase project (e.g., https://your-project.supabase.co or local http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable / Anon Key (SAFE to expose client-side in browser and mobile app)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (NEVER expose to client, browser or mobile app - server-only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Mobile Application Configuration (Dart defines / Flutter Secure Storage)
# ------------------------------------------------------------------------------
# Pass to flutter run via:
# flutter run --dart-define=SUPABASE_URL=https://your-project.supabase.co --dart-define=SUPABASE_ANON_KEY=ey...
QUESTLY_MOBILE_ENV=development
QUESTLY_API_BASE_URL=https://your-project-id.supabase.co/rest/v1
QUESTLY_CONNECT_TIMEOUT_SECONDS=15
QUESTLY_RECEIVE_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# Web Application Host
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
